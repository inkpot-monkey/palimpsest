{
  self,
  pkgs,
  ...
}:

# The fleet's log-level patterns (modules/shared/log-level-patterns.nix), run by the REAL VRL
# compiler against a corpus of REAL lines captured from the fleet's own VictoriaLogs.
#
# WHY THIS EXISTS. `level` is what every error view on the fleet selects on — the Logs
# dashboard's whole Errors/Warnings half is `level:in(error,critical,fatal)` — and journald can
# only report PRIORITY, which is 6 for every line a service writes to stdout. So each of these
# patterns is the ONLY thing standing between a service's errors and total invisibility, and the
# failure mode is silence: a pattern that stops matching after an upstream format change does not
# error, it just quietly labels everything `info` again. Nothing else would notice.
#
# Two hazards in particular, both of which have already happened and both of which are cases
# below:
#
#   * ⚠ AN UNANCHORED PATTERN IS WORSE THAN NONE. A fleet-wide `_msg:~"ERROR"` sweep named blocky
#     the worst offender by two orders of magnitude — 45k lines on kelpy, 12.5k on rk1b — and
#     every one was the substring inside `response_code=NOERROR` on a perfectly ordinary query
#     log. A pattern that loose would relabel 1.5 million query logs a month as failures.
#   * ⚠ CONTINUATION LINES ARE NOT EVENTS. A python traceback, a postgres DETAIL/HINT, immich's
#     multi-line Postgres notices — each belongs to the message above it. Matching them would
#     treble every warning and make a 20-line traceback read as twenty errors.
#
# ── WHAT MAKES THIS A TEST RATHER THAN A RESTATEMENT ─────────────────────────────────────────
# The VRL is not written here. It is generated by the real module — `custom.profiles.
# monitoring-client` on a real host, extended with the corpus's unit map — and executed by the
# real `vector vrl`, so what is under test is the program the fleet actually runs, including the
# level-name mapping table and the ordering of promotion before demotion. The corpus lines are
# verbatim journal messages (ANSI escapes and all), truncated and with addresses and room ids
# redacted; nothing about their shape is invented.
#
# ── COMPLETENESS, IN BOTH DIRECTIONS ─────────────────────────────────────────────────────────
# Beyond the cases, this asserts:
#   * every pattern in the catalogue is exercised by at least one case — so a pattern cannot be
#     added without evidence that it works;
#   * every (unit → pattern) any host in the fleet declares appears in the corpus with the same
#     pattern — so a service cannot be wired up without a test, which is the hole that would
#     otherwise re-open the moment someone adds the tenth service.
#
# Add to the corpus by capturing a real line; the catalogue's header has the query.

let
  inherit (pkgs) lib;

  corpus = lib.importJSON ./corpus.json;
  patterns = self.lib.logLevelPatterns;

  # Units with a pattern get one; `pattern: null` means "deliberately not wired", and its cases
  # assert that nothing happens to it (see the sshd case and the reason beside it).
  wired = lib.filterAttrs (_: u: u.pattern != null) corpus.units;

  unknownPatterns = lib.filter (n: !(patterns ? ${n})) (lib.mapAttrsToList (_: u: u.pattern) wired);

  # The VRL the fleet runs, generated by the module itself rather than restated here. rk1b is
  # the carrier because it already enables the monitoring client; the units come from the
  # corpus, so this exercises every pattern on one program.
  carrier = self.nixosConfigurations.rk1b.extendModules {
    modules = [
      {
        custom.profiles.monitoring-client = {
          levelFromMessage = lib.mkForce (lib.mapAttrs (_: u: patterns.${u.pattern}) wired);
          demoteToDebug = lib.mkForce (
            lib.mapAttrs (_: u: u.demote) (lib.filterAttrs (_: u: u ? demote) corpus.units)
          );
        };
      }
    ];
  };
  program = carrier.config.services.vector.settings.transforms.parse_journal.source;

  # Every pattern must be used by something, so the catalogue cannot grow untested entries.
  usedPatterns = lib.unique (lib.mapAttrsToList (_: u: u.pattern) wired);
  unusedPatterns = lib.filter (n: !(lib.elem n usedPatterns)) (lib.attrNames patterns);

  # ...and nothing the fleet declares may be missing from the corpus. Collected across every
  # host, so wiring a service up without a test fails here rather than in six months.
  fleetDeclared = lib.foldl' (
    acc: host: acc // (host.config.custom.profiles.monitoring-client.levelFromMessage or { })
  ) { } (lib.attrValues self.nixosConfigurations);

  untested = lib.filter (unit: !(corpus.units ? ${unit}) || (corpus.units.${unit}.pattern == null)) (
    lib.attrNames fleetDeclared
  );

  mismatched = lib.filter (
    unit:
    (corpus.units ? ${unit})
    && (corpus.units.${unit}.pattern != null)
    && patterns.${corpus.units.${unit}.pattern} != fleetDeclared.${unit}
  ) (lib.attrNames fleetDeclared);

  casesJson = builtins.toJSON corpus.cases;
in
assert lib.assertMsg (unknownPatterns == [ ])
  "parts/checks/log-levels: corpus.json names pattern(s) absent from the catalogue: ${toString unknownPatterns}";
assert lib.assertMsg (unusedPatterns == [ ])
  "parts/checks/log-levels: these patterns in modules/shared/log-level-patterns.nix are exercised by no case in corpus.json: ${toString unusedPatterns}. A pattern with no evidence is a pattern that may already have stopped matching — capture a real line (the catalogue header has the query) and add it.";
assert lib.assertMsg (untested == [ ])
  "parts/checks/log-levels: ${toString untested} — a host declares levelFromMessage for these units, but corpus.json has no wired entry for them. The whole failure mode here is silence, so a pattern in production without a real-line case is exactly the hole this check exists to close.";
assert lib.assertMsg (mismatched == [ ])
  "parts/checks/log-levels: ${toString mismatched} — the pattern a host declares differs from the catalogue pattern the corpus tests. Point the profile at self.lib.logLevelPatterns.<name> rather than an inline regex, or add the new format to the catalogue.";
pkgs.runCommand "check-log-levels"
  {
    nativeBuildInputs = [
      pkgs.vector
      pkgs.python3
    ];
    inherit program;
    passAsFile = [
      "program"
      "cases"
    ];
    cases = casesJson;
  }
  ''
    set -euo pipefail
    cp "$programPath" program.vrl
    cp "$casesPath" cases.json

    echo "--- the program under test (generated by custom.profiles.monitoring-client) ---"
    grep -c . program.vrl | sed 's/^/  lines: /'

    python3 ${./verify.py} program.vrl cases.json
    touch $out
  ''
