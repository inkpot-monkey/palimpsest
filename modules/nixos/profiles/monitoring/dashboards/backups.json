        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Annex replication (per link)",
      "description": "Per-repo assistant liveness and per-remote reachability, across hosts and users. Green UP / red DOWN.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(git_annex_assistant_up, \"host\", \"$1\", \"instance\", \"([^.:]+).*\")",
          "instant": true,
          "legendFormat": "{{host}}/{{user}}/{{repo}} assistant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(git_annex_remote_reachable, \"host\", \"$1\", \"instance\", \"([^.:]+).*\")",
          "instant": true,
          "legendFormat": "{{host}}/{{user}}/{{repo}} \u2192 {{remote}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Annex repositories \u2014 across hosts and users",
      "description": "Every git-annex repo on the fleet, host and home-manager alike, enriched from git_annex_repo_info. Value is time since the newest commit on any ref (context, not liveness \u2014 an idle repo goes stale by design). Live assistant/remote health is the state strip above.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - label_replace(git_annex_last_commit_timestamp_seconds * on(instance,repo,user) group_left(description,group,wanted) git_annex_repo_info, \"host\", \"$1\", \"instance\", \"([^.:]+).*\")",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(host|user|repo|description|group|wanted|Value)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "host": 0,
              "user": 1,
              "repo": 2,
              "description": 3,
              "group": 4,
              "wanted": 5,
              "Value": 6
            },
            "renameByName": {
              "host": "Host",
              "user": "User",
              "repo": "Repo",
              "description": "Description",
              "group": "Group",
              "wanted": "Wanted",
              "Value": "Since last commit"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": "",
            "sort": [
              {
                "field": "Since last commit",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Since last commit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
