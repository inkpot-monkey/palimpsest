# =========================================
# Nix Build Artifacts
# =========================================
result
result-*

# =========================================
# Environment & Secrets
# =========================================
# Direnv environment loader
.direnv

# Local credentials loaded by hand (e.g. CACHIX_AUTH_TOKEN for a cache push).
# Named here and not only in ~/.config/git/ignore: a global ignore protects THIS
# checkout on THIS machine, and nothing at all in a fresh clone — which is the one
# place a stray `git add -A` would commit a live token.
.env
.env.*
!.env.example

# SSH keys generated for bootstrapping (should not be committed)
keys/
!users/*/keys

secrets/
.antigravity

# =========================================
# Virtualization & Disk Images
# =========================================
# QEMU disk images
*.qcow2
# ISO images (installers)
*.iso

# =========================================
# Editor & OS Files
# =========================================
# macOS metadata
.DS_Store
# Vim swap files
*.swp
# Backup files
*~

# =========================================
# Rust / Cargo
# =========================================
# Rust build directory
target/
# bacon background-check log
bacon.log

# =========================================
# Python
# =========================================
__pycache__/
*.py[cod]

# =========================================
# Emacs / Temp
# =========================================
**/emacs/playground/
# repo-level dir-locals are intentionally tracked (overrides global gitignore)
!.dir-locals.el

# =========================================
# Pre-commit Hooks
# =========================================
# Generated by git-hooks.nix
.pre-commit-config.yaml

# =========================================
# Local issue tracker (working notes, not version-controlled)
# =========================================
.scratch/
